# Opcionalno: kopiraj u .env samo ako želiš promijeniti zadano. .env nije u gitu.

# Postav kalibracija (mapa u privatnom repou CroboticSolutions/demomotion_calibration).
# Prazno = ime ovog računala (npr. toni-legion). Postavi samo ako ime računala nije jedinstveno
# ili jedno računalo vozi više postava. Nikad tuđi postav.
DEMOMOTION_CALIBRATION_SET=

# Podaci: checkout kalibracija, bagovi, diagnostics, logovi
DEMOMOTION_DATA=$HOME/demomotion_data

# Isti kao u razvojnom kontejneru (setup_ros_domain.sh)
ROS_DOMAIN_ID=52

# Paralelni colcon workeri u buildu (manje = manje RAM-a)
COLCON_WORKERS=4

# FoundationPose CUDA ekstenzije: GPU arhitekture (8.6 RTX 30xx, 8.9 RTX 40xx, 12.0 RTX 50xx)
# i paralelni nvcc procesi (svaki 2-3 GB RAM-a). Samo svoja arhitektura = brži build.
FP_CUDA_ARCHS="8.6;8.9;12.0"
FP_MAX_JOBS=2

DEMOMOTION_IMAGE=demomotion:latest
