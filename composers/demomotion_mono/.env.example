# Kopira se u .env (to radi ./setup_host.sh). .env nije u gitu.

# Modeli (read-only), struktura u README.md
DEMOMOTION_MODELS=/opt/demomotion/models
# Kalibracija, bagovi, diagnostics, logovi
DEMOMOTION_DATA=/opt/demomotion/data

# Isti kao u razvojnom kontejneru (setup_ros_domain.sh)
ROS_DOMAIN_ID=52

# Paralelni colcon workeri u buildu (manje = manje RAM-a)
COLCON_WORKERS=4

# FoundationPose CUDA ekstenzije: GPU arhitekture (8.6 RTX 30xx, 8.9 RTX 40xx, 12.0 RTX 50xx)
# i paralelni nvcc procesi (svaki 2-3 GB RAM-a). Samo svoja arhitektura = brži build.
FP_CUDA_ARCHS="8.6;8.9;12.0"
FP_MAX_JOBS=2

DEMOMOTION_IMAGE=demomotion:latest
